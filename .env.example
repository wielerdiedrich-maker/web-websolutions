# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on
PORT=3000

# Set to "production" when deployed behind HTTPS (enables secure cookies)
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin login credentials.
# Generate ADMIN_PASSWORD_HASH with: node server/hashPassword.js "YourStrongPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional: email notifications for new contact-form submissions.
# Every submission is always saved and visible in /admin regardless of
# whether these are set — this only adds an email alert on top.
# Example for Gmail: create an "App Password" at myaccount.google.com/apppasswords
# (requires 2-Step Verification), then use it as SMTP_PASS below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
