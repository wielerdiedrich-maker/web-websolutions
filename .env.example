# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on
PORT=3000

# Set to "production" when deployed behind HTTPS (enables secure cookies)
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin login credentials.
# Generate ADMIN_PASSWORD_HASH with: node server/hashPassword.js "YourStrongPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ===== DW Lead Machine (optional integrations — all degrade gracefully when unset) =====

# OpenAI API key for AI lead qualification (https://platform.openai.com/api-keys).
# Without this, leads are still qualified via a transparent rule-based
# fallback instead of being blocked or broken.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SMTP credentials for customer confirmations, owner notifications, and
# follow-up emails. Without these, emails are logged server-side and marked
# "not sent" instead of throwing. Works with any SMTP provider (Gmail app
# password, SendGrid, Postmark, etc.) — 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared secret required on the /api/webhooks/calendly endpoint (as
# ?token=... or an X-Webhook-Token header) until real Calendly webhook
# signature verification is wired up. Leave unset to disable the route
# (it responds 501 "not configured").
CALENDLY_WEBHOOK_SECRET=

# How often (minutes) the in-process follow-up scheduler checks for leads
# that are due for their next automated follow-up email.
FOLLOWUP_INTERVAL_MINUTES=60

# Used to build the unsubscribe link in follow-up emails, e.g.
# https://leads.dwwebsolutions.com — leave unset in local dev.
PUBLIC_BASE_URL=
